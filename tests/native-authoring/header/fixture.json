              "id": "content-entry-7ccd88dd-dd45-440f-83d7-c44abfdca113",
              "modelId": "note",
              "createdAt": "2026-11-17T02:30:40.708Z",
              "updatedAt": "2026-11-17T03:01:17.214Z",
              "values": {
                "note-slug": "pilot-1794882566531",
