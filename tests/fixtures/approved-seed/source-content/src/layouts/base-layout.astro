---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteHeader from '@components/site-header/site-header.astro';
import SiteFooter from '@components/site-footer/site-footer.astro';
import ColorPanel from '@components/color-panel/color-panel';
import PageLoadingOverlay from '@components/page-loading-overlay/page-loading-overlay.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pinsel - ドイツ美大受験オンラインクラス',
  description = 'ドイツ美大受験をマンツーマンでサポート。123件以上の合格実績。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Pinsel - ドイツ美大受験オンラインクラス" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Montserrat:wght@200;300;400;500;700&family=Raleway:wght@200;300&family=Zen+Kaku+Gothic+New:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <!-- View Transitions -->
    <ClientRouter />
  </head>
  <body class="font-light">
    <SiteHeader />
    <main class="px-hgap-sm md:px-hgap-md" transition:animate="fade">
      <slot />
    </main>
    <SiteFooter />
    <PageLoadingOverlay />
    {import.meta.env.DEV && <ColorPanel client:only="react" transition:persist />}
  </body>
</html>
