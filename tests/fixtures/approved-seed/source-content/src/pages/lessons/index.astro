---
import BaseLayout from '../../layouts/base-layout.astro';
import Section from '@components/section/section.astro';
import CtaSection from '@components/cta-section/cta-section.astro';
import TargetChecklist from '@components/target-checklist/target-checklist.astro';
import PageHeader from '@components/page-header/page-header.astro';
import Breadcrumb from '@components/breadcrumb/breadcrumb.astro';
import SectionImage from '@components/section-image/section-image.astro';
import InfoCard from '@components/info-card/info-card.astro';
import CareerTimeline from '@components/career-timeline/career-timeline.astro';
import InPageDivider from '@components/in-page-divider/in-page-divider.astro';
import NoteCard from '@components/note-card/note-card.astro';

const title = 'オンラインクラス - Pinsel';
const description =
  'ドイツ美大受験のためのオンラインマンツーマンレッスン。マッペ制作から出願まで完全サポート。';

const recommendedItems = [
  'クリエイティブなことが好きな方',
  '海外の美大に興味があるが、学費についてお悩みの方',
  '初心者・経験者問わず、ドイツ美大進学を目指す方',
  '学生さん（高校、大学、専門）、社会人 問わず、ドイツ美大進学を目指す方',
  '将来的にドイツでのアーティスト活動や就職に興味がある方',
  'マッペ（ポートフォリオ）制作や受験についてアドバイスが欲しい方',
  'ドイツ美大受験の最中・直前で、まとめとしてのアドバイス・サポートを必要とする方',
];

const specializations = [
  { de: 'Malerei und Grafik', ja: '絵画とグラフィック' },
  { de: 'Bildhauerei', ja: '彫刻とインスタレーション' },
  { de: 'Visuelle Kommunikation', ja: 'ヴィジュアルコミュニケーション/デザイン' },
  { de: 'Kunst und Medien', ja: 'メディアアート' },
  { de: 'Innenarchitektur', ja: 'インテリアデザイン' },
  { de: 'Modedesign', ja: 'モードデザイン・ファッション' },
  { de: 'Produktdesign', ja: 'プロダクトデザイン' },
  { de: 'Illustration und Buchdesign', ja: 'イラストレーション・ブックデザイン' },
  { de: 'Textil und Flächendesign', ja: 'テキスタイル・平面デザイン' },
];

const careerTimeline = [
  { year: '1987', text: '埼玉県生まれ' },
  { year: '2006〜2010', text: '東京芸術大学 美術学部 絵画科 油画専攻 卒業' },
  {
    year: '2010〜2016',
    text: 'ミュンヘン芸術アカデミー 自由芸術科 マイスターシューラーとして卒業',
  },
  { year: '2010〜2014', text: 'ミュンヘン滞在' },
  { year: '2014〜2020', text: 'ベルリン滞在、Atelier HY+ 経営' },
  { year: '2020', text: '日本に帰国、Pinsel ドイツ美大受験オンラインクラス 開始' },
  { year: '2020〜2023', text: '創形美術学校 海外美術留学準備コース ドイツ対策クラス担当' },
];

const knowledgeCards = [
  {
    href: '/notes/free-tuition/',
    title: 'ドイツの美大は学費が無料',
    description: 'ドイツ国立美大の学費無料の仕組みと生活費の目安',
  },
  {
    href: '/notes/what-is-mappe/',
    title: 'マッペ（ポートフォリオ）とは',
    description: 'ドイツ美大受験に必須のマッペについて解説',
  },
  {
    href: '/notes/exam-schedule/',
    title: 'ドイツ美大受験の時期とスケジュール',
    description: '受験スケジュールと準備開始の目安',
  },
  {
    href: '/notes/online-exam/',
    title: 'オンラインでのドイツ美大受験について',
    description: '日本にいながらオンラインで受験する方法',
  },
  {
    href: '/notes/german-language/',
    title: 'ドイツ語学習について',
    description: '受験に必要なドイツ語レベルと学習方法',
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <Section>
    <Breadcrumb
      items={[{ label: '', href: '/' }, { label: 'ドイツ美大受験オンラインクラス' }]}
    />
    <PageHeader
      title="ドイツ美大受験オンラインクラス"
      description="将来的にドイツ美大受験を目指す方や、ドイツの美大に興味があるけれど何から始めたらいいのかわからない！という方を対象とした、マンツーマンレッスンのオンラインクラスです。"
    />
  </Section>

  <!-- Knowledge -->
  <Section title="Knowledge">
    <div class="grid grid-cols-1 gap-hgap-xs md:grid-cols-2">
      {knowledgeCards.map((card) => (
        <NoteCard
          href={card.href}
          title={card.title}
          description={card.description}
        />
      ))}
    </div>
  </Section>

  <InPageDivider />

  <!-- Recommended Students -->
  <Section title="For You">
    <h2 class="text-lg text-pd-fg">このような方に受講をお勧めします</h2>
    <div class="mt-vgap-md">
      <TargetChecklist items={recommendedItems} />
    </div>
    <div class="mt-vgap-md">
      <SectionImage src="/images/section-online-lesson-work.jpg" alt="画材" />
    </div>
  </Section>

  <InPageDivider />

  <!-- Instructor Bio -->
  <Section title="Instructor">
    <div class="flex flex-col items-center gap-vgap-md md:flex-row md:items-start">
      <div class="h-[160px] w-[160px] shrink-0 overflow-hidden rounded-full border border-pd-border">
        <img
          src="/images/instructor-yuko.jpg"
          alt="高津戸 優子"
          width="160"
          height="160"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex-1">
        <p class="text-xl font-bold text-pd-fg">高津戸 優子</p>
        <p class="mt-vgap-2xs text-pd-muted">Yuko Takatsudo</p>
        <p class="mt-vgap-xs leading-relaxed text-pd-fg">
          ドイツに10年間滞在し日本とドイツで美大を卒業、現在も東京とベルリンを拠点にアーティスト活動中。
        </p>
      </div>
    </div>

    <div class="mt-vgap-lg">
      <h3 class="font-bold text-pd-fg">経歴</h3>
      <div class="mt-vgap-sm">
        <CareerTimeline items={careerTimeline} />
      </div>
    </div>
  </Section>

  <InPageDivider />

  <!-- Specializations -->
  <Section title="Specializations">
    <h2 class="text-lg text-pd-fg">ドイツ美術大学 専攻分野一例</h2>
    <div class="mt-vgap-md grid grid-cols-1 gap-vgap-xs md:grid-cols-2">
      {specializations.map((item) => (
        <div class="rounded-md border border-pd-border bg-pd-bg px-hgap-sm py-vgap-xs">
          <p class="font-medium text-pd-fg">{item.de}</p>
          <p class="mt-vgap-2xs text-sm text-pd-muted">{item.ja}</p>
        </div>
      ))}
    </div>
    <p class="mt-vgap-md leading-relaxed text-pd-fg">
      どの学科の生徒さんも、今までドイツ美大進学をサポートをさせて頂きました。専攻に迷っている方もご安心ください。
    </p>
  </Section>

  <InPageDivider />

  <!-- Course Structure -->
  <Section title="Course">
    <h2 class="text-lg text-pd-fg">オンラインクラス授業内容</h2>
    <p class="mt-vgap-sm leading-relaxed text-pd-fg">
      ２ヶ月コースまたは４ヶ月コースからお選びいただけます。授業は1対1のオンライン通話で、1授業につき約1時間半〜2時間です。
    </p>

    <div class="mt-vgap-md flex flex-col gap-vgap-md">
      <InfoCard
        title="1〜4授業目（2ヶ月・4ヶ月共通）"
        description="課題の作品制作、受験情報の共有、合格者ポートフォリオの紹介を行います。まず合格した生徒さんのマッペを見せて、基礎的なこと（構図・抽象と具象）を学びます。"
      />
      <InfoCard
        title="5〜8授業目（4ヶ月コースのみ）"
        description="進行具合により引き続き課題制作を行い、自分のテーマでの作品制作に入ります。専攻やテーマに沿った内容で制作を進めます。"
      />
      <InfoCard
        title="受講終了後"
        description="多くの方が受験の時期までクラスを延長して受講されています。"
      />
    </div>
  </Section>

  <InPageDivider />

  <!-- Pricing Detail -->
  <Section title="Pricing">
    <h2 class="text-lg text-pd-fg">オンラインクラス価格</h2>

    <div class="mt-vgap-md grid grid-cols-1 gap-hgap-sm md:grid-cols-2">
      <div class="rounded-md border border-pd-border bg-pd-bg px-hgap-sm py-vgap-sm text-center">
        <p class="text-sm font-bold tracking-[2px] text-pd-muted">2ヶ月コース</p>
        <p class="mt-vgap-xs font-montserrat text-2xl font-bold text-pd-link">¥50,000</p>
        <p class="mt-vgap-2xs text-sm text-pd-muted">税込 / 1ヶ月あたり25,000円</p>
      </div>
      <div class="rounded-md border-[2px] border-pd-accent bg-pd-bg px-hgap-sm py-vgap-sm text-center">
        <p class="text-sm font-bold tracking-[2px] text-pd-muted">4ヶ月コース</p>
        <p class="mt-vgap-xs font-montserrat text-2xl font-bold text-pd-link">¥92,000</p>
        <p class="mt-vgap-2xs text-sm text-pd-muted">税込 / 1ヶ月あたり23,000円</p>
      </div>
    </div>

    <div class="mt-vgap-md flex flex-col gap-vgap-xs text-pd-fg">
      <p>
        <span class="font-medium">レッスンスケジュール：</span>
        土日祝日を除く平日10時、14時、19時スタート（週末レッスンも時々あり）
      </p>
      <p>引き続き受講希望の場合は、新たにコースをお申し込みいただけます。</p>
      <p>お支払いは銀行振り込みとなります。</p>
    </div>
  </Section>

  <InPageDivider />

  <!-- Paid Consultation -->
  <Section title="Consultation">
    <h2 class="text-lg text-pd-fg">オンライン有料進路相談</h2>

    <div class="mt-vgap-md rounded-md border border-pd-border bg-pd-bg px-hgap-sm py-vgap-sm text-center">
      <p class="text-sm font-bold tracking-[2px] text-pd-muted">進路相談</p>
      <p class="mt-vgap-xs font-montserrat text-2xl font-bold text-pd-link">¥10,000</p>
      <p class="mt-vgap-2xs text-sm text-pd-muted">税込 / 1時間半〜2時間のオンライン通話</p>
    </div>

    <div class="mt-vgap-md grid grid-cols-1 gap-vgap-md md:grid-cols-2">
      <div>
        <h3 class="font-bold text-pd-fg">面談で話す内容</h3>
        <ul class="mt-vgap-sm flex flex-col gap-vgap-xs">
          {[
            'ドイツの美術大学の学位システムについて',
            '受験までのスケジュール',
            'ドイツ語学習の方法',
            '専攻について',
            '学費や現地での生活費',
          ].map((item) => (
            <li class="flex items-start gap-hgap-xs text-sm text-pd-fg">
              <span class="mt-[2px] text-pd-link" aria-hidden="true">・</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-bold text-pd-fg">よくある質問</h3>
        <ul class="mt-vgap-sm flex flex-col gap-vgap-xs">
          {[
            '応募資格の確認',
            'ドイツでアートを勉強する利点',
            '初心者でも進学可能か',
            '複数の専攻で迷っている',
            '卒業後の進路',
            '就職を考えるとどの専攻が良いか',
          ].map((item) => (
            <li class="flex items-start gap-hgap-xs text-sm text-pd-fg">
              <span class="mt-[2px] text-pd-link" aria-hidden="true">・</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <InPageDivider />

  <!-- For Art Graduates -->
  <Section title="For Graduates">
    <h2 class="text-lg text-pd-fg">美大卒の方へ</h2>
    <div class="mt-vgap-sm flex flex-col gap-vgap-sm leading-relaxed text-pd-fg">
      <p>
        日本で美大を卒業された方にもドイツ美大進学はおすすめです。学生ビザの取得、大学のアトリエの利用、学割、現地でのコネクション作り、新たなインスピレーションなど、多くのメリットがあります。
      </p>
      <p>
        講師自身も、芸大在学中にドイツに行くきっかけができました。ミュンヘンで学生となり、結局10年もドイツに滞在することになりました。
      </p>
      <p>
        今までのスタイルにこだわらず、新たな試みで制作すると良い結果につながることが多いです。
      </p>
      <p>
        受験そのものが目的ではなく、作品制作の継続・発展が本来の目的です。ドイツでの学びを通じて、アーティストとしての新たな一歩を踏み出しましょう。
      </p>
    </div>
  </Section>

  <InPageDivider />

  <!-- CTA -->
  <CtaSection
    text="お問い合わせ"
    href="/contact/"
    subCopy="まずはお気軽にご相談ください。ささいなことでも構いません。"
  />
</BaseLayout>
