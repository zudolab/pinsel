---
export type Stat = {
  number: string;
  label: string;
};

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---
<div class="py-vgap-lg">
  <div class="mx-auto flex max-w-4xl items-center justify-center gap-hgap-xs md:gap-hgap-sm">
    {stats.map((stat) => (
      <div class="flex h-[110px] w-[110px] flex-col items-center justify-center rounded-full bg-pd-bg border border-pd-link md:h-[224px] md:w-[224px]">
        <p class="font-futura text-lg font-medium text-pd-link md:text-3xl">
          {stat.number}
        </p>
        <p class="mt-vgap-2xs text-[12px] font-medium tracking-[2px] text-pd-muted md:text-sm">
          {stat.label}
        </p>
      </div>
    ))}
  </div>
</div>
