---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---
<section class:list={['px-hgap-sm py-vgap-xl md:px-hgap-md', className]}>
  <div class="mx-auto max-w-5xl">
    {title && (
      <p class="mb-vgap-md flex items-center justify-center gap-hgap-sm text-[18px] italic tracking-[6px] uppercase text-pd-muted before:h-px before:w-[40px] before:bg-pd-border after:h-px after:w-[40px] after:bg-pd-border">
        {title}
      </p>
    )}
    <slot />
  </div>
</section>
