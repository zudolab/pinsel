{
  "name": "@pinsel/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./content-validation": "./src/native-content-validation.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "content:assemble": "tsx --tsconfig tsconfig.scripts.json src/site/assemble.ts",
    "content:project": "tsx --tsconfig tsconfig.scripts.json src/site/project.ts",
    "content:import": "node ../../scripts/content/import-seed.mjs",
    "content:validate": "tsx --tsconfig tsconfig.scripts.json src/site/validate.ts",
    "content:check": "tsx --tsconfig tsconfig.scripts.json src/site/check.ts",
    "authoring:init": "tsx --tsconfig tsconfig.scripts.json src/site/initialize-native.ts",
    "authoring:dev": "tsx --tsconfig tsconfig.scripts.json src/site/start-native.ts",
    "authoring:capture": "tsx --tsconfig tsconfig.scripts.json src/site/capture-native.ts",
    "authoring:build": "tsx --tsconfig tsconfig.scripts.json src/site/build-native-snapshot.ts",
    "authoring:migrate-course": "tsx --tsconfig tsconfig.scripts.json src/site/stage-course-identity.ts",
    "authoring:migrate-notes": "tsx --tsconfig tsconfig.scripts.json src/site/stage-note-routes.ts"
  },
  "dependencies": {
    "@pinsel/ui": "workspace:*",
    "@takazudo/zfb": "5.1.5",
    "@zudo-composer/component-contract": "git+https://github.com/Takazudo/zudo-composer.git#c0b452da075b66757c60bd0d721a47062d4354d0",
    "preact": "^10.29.8",
    "zod": "^4.3.6",
    "zudo-composer": "git+https://github.com/Takazudo/zudo-composer.git#0ec2e6949a72daca8619aa863989732763702e84"
  }
}
