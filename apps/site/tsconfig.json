{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@takazudo/zfb/zudo-react",
    "allowImportingTsExtensions": true,
    "paths": { "~/*": ["./*"] },
