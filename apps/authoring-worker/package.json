{
  "name": "@pinsel/authoring-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "styles:generate": "node scripts/generate-preview-styles.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply pinsel-authoring --local --env local",
    "dev:local": "wrangler dev --env local",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "types": "wrangler types --strict-vars=false",
    "types:check": "wrangler types --strict-vars=false --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pinsel/content": "workspace:*",
    "@pinsel/ui": "workspace:*",
    "@takazudo/zfb": "4.3.2",
    "@zudo-composer/component-contract": "git+https://github.com/Takazudo/zudo-composer.git#c0b452da075b66757c60bd0d721a47062d4354d0",
    "jose": "6.2.12",
    "zod": "^4.3.6",
    "zudo-composer": "git+https://github.com/Takazudo/zudo-composer.git#547b532eb56dfecaec1e2bd9060f8d579ad8862c"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "preact": "^10.29.8",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
