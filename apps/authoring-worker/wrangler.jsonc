{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinsel-authoring",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-12",
  // Never deployed from this repository: CI only runs `wrangler deploy --dry-run`.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // Written only by scripts/assets/assemble-worker.mjs.
    "directory": "./dist-assets/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request, including navigations, must pass the Worker's auth gate.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
